{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/dataset.schema.json",
  "title": "Ethics v1 dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "sourceIds",
    "metricId",
    "observationIds",
    "methodology",
    "limitations",
    "freshness",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "kind": {
      "const": "dataset"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metricId": {
      "type": "string",
      "minLength": 1
    },
    "observationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "methodology": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
