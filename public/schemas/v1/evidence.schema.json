{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/evidence.schema.json",
  "title": "Ethics v1 evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "sourceId",
    "url",
    "locator",
    "excerpt",
    "rawRef",
    "publishedAt",
    "retrievedAt",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "kind": {
      "const": "evidence"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "excerpt": {
      "type": "string",
      "minLength": 1
    },
    "rawRef": {
      "type": "string",
      "minLength": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
