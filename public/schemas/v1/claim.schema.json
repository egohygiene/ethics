{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/claim.schema.json",
  "title": "Ethics v1 claim",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "statement",
    "classification",
    "evidenceRefs",
    "sourceIds",
    "limitations",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "kind": {
      "const": "claim"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "observed_fact",
        "documented_estimate",
        "projection",
        "interpretation",
        "authors_perspective",
        "open_question"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
