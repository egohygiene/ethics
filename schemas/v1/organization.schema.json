{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/organization.schema.json",
  "title": "Ethics v1 organization",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "url",
    "description",
    "topics",
    "sourceIds",
    "accessNotes",
    "akashicUrl",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "kind": {
      "const": "organization"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "accessNotes": {
      "type": "string",
      "minLength": 1
    },
    "akashicUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
