{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/observation.schema.json",
  "title": "Ethics v1 observation",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "datasetId",
    "metricId",
    "label",
    "period",
    "classification",
    "amount",
    "evidenceRefs",
    "sourceIds",
    "methodology",
    "uncertainty",
    "freshness",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "kind": {
      "const": "observation"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "metricId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "observed_fact",
        "documented_estimate",
        "projection"
      ]
    },
    "amount": {
      "$ref": "common.schema.json#/$defs/field"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "methodology": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
