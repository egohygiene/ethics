{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/perspective.schema.json",
  "title": "Ethics v1 perspective",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "dimension",
    "question",
    "classification",
    "established",
    "notEstablished",
    "perspectives",
    "values",
    "uncertainty",
    "interventions",
    "sourceIds",
    "evidenceRefs",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "kind": {
      "const": "perspective"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dimension": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "const": "interpretation"
    },
    "established": {
      "type": "string",
      "minLength": 1
    },
    "notEstablished": {
      "type": "string",
      "minLength": 1
    },
    "perspectives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title",
          "argument"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "argument": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "values": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    }
  },
  "additionalProperties": false
}
