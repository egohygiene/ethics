{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethics.egohygiene.io/schemas/v1/common.schema.json",
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "status",
        "checkedAt",
        "humanReviewedAt",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "agent_checked",
            "metadata_checked",
            "needs_review",
            "human_reviewed"
          ]
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "humanReviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "human_reviewed"
              }
            }
          },
          "then": {
            "properties": {
              "humanReviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "agent_checked",
                  "metadata_checked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "checkedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "freshness": {
      "type": "object",
      "required": [
        "sourceDataPeriod",
        "sourcePublishedAt",
        "lastCheckedAt",
        "lastMaterialChangeAt",
        "lastAgentReviewAt",
        "lastHumanReviewAt"
      ],
      "properties": {
        "sourceDataPeriod": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourcePublishedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "lastCheckedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastMaterialChangeAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastAgentReviewAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastHumanReviewAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "status",
        "value",
        "evidenceRefs",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "conflicting",
            "unknown",
            "not_available",
            "not_researched",
            "not_applicable"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "known",
                  "conflicting"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              },
              "evidenceRefs": {
                "minItems": 1,
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conflicting"
              }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "minItems": 2,
                "type": "array"
              }
            }
          }
        }
      ]
    }
  }
}
