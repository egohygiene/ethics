{
  "name": "@egohygiene/ethics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/materialize.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "node scripts/validate.mjs && node scripts/validate-candidates.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run validate && npm test && npm run build",
    "refresh": "node --use-env-proxy scripts/refresh-research.mjs",
    "links": "node --use-env-proxy scripts/check-links.mjs",
    "qa:screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.73.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.11.1"
  }
}
